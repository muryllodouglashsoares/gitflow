{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissões mínimas da janela principal: seletor de pasta, consultas Git e as operações locais predefinidas da Fase 2 (branch e commit) e a sincronização remota predefinida da Fase 3 (diagnóstico, fetch, pull e push) e os comandos predefinidos da importação de ZIP da Fase 4.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "allow-check-git",
    "allow-open-repository",
    "allow-get-repository-status",
    "allow-get-file-diff",
    "allow-list-branches",
    "allow-check-branch-name",
    "allow-create-branch",
    "allow-switch-branch",
    "allow-prepare-commit-review",
    "allow-create-commit",
    "allow-get-sync-status",
    "allow-fetch-remote",
    "allow-pull-branch",
    "allow-push-branch",
    "allow-inspect-zip",
    "allow-prepare-import-branch",
    "allow-apply-import",
    "allow-rollback-import",
    "allow-create-import-commit",
    "allow-push-import-branch",
    "allow-find-import-operation",
    "allow-finish-import"
  ]
}
