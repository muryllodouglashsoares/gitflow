{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissões mínimas da janela principal: seletor de pasta e consultas Git somente leitura.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "allow-check-git",
    "allow-open-repository",
    "allow-get-repository-status",
    "allow-get-file-diff"
  ]
}
