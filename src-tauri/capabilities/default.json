{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissões mínimas da janela principal: seletor de pasta, consultas Git e as operações locais predefinidas da Fase 2 (branch e commit).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "allow-check-git",
    "allow-open-repository",
    "allow-get-repository-status",
    "allow-get-file-diff",
    "allow-list-branches",
    "allow-check-branch-name",
    "allow-create-branch",
    "allow-switch-branch",
    "allow-prepare-commit-review",
    "allow-create-commit"
  ]
}
